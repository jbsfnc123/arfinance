{
  "name": "erp-bot",
  "private": true,
  "type": "module",
  "description": "Bot ERP: unduh Aging Detail dari Jaspersoft → arsip Google Drive → upload ke database AR Workspace (dijalankan di PC lokal).",
  "scripts": {
    "start": "tsx src/index.ts",
    "dry-run": "tsx src/index.ts --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "dotenv": "^17.2.3",
    "puppeteer": "^24.23.0",
    "tsx": "^4.20.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "puppeteer@24.43.1": true
  }
}
