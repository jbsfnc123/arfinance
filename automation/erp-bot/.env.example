# Salin menjadi .env (file .env TIDAK di-commit).

# Login Jaspersoft (report.tangki.id)
JASPER_USERNAME=
JASPER_PASSWORD=
# true = browser tidak terlihat (dipakai Task Scheduler); false = tampilkan browser untuk memantau
BOT_HEADLESS=true

# Arsip Google Drive: URL Web App "ERP Drive Inbox" (…/exec) & rahasia yang sama dengan Script Properties ERP_DRIVE_SECRET
ERP_DRIVE_URL=
ERP_DRIVE_SECRET=

# Database AR Workspace (nilai publik, sama dengan NEXT_PUBLIC_* di aplikasi)
SUPABASE_URL=https://knytaubhwnahnpamkhgz.supabase.co
SUPABASE_ANON_KEY=
# Akun sistem "Bot ERP" — dicetak oleh: node --env-file=.env.local scripts/create-bot-account.mjs
BOT_EMAIL=
BOT_PASSWORD=
