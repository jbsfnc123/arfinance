# Salin ke .env.local. Nilai ada di Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (tanpa prefix NEXT_PUBLIC_). Dipakai login PIN dan kelola akun.
SUPABASE_SERVICE_ROLE_KEY=
# 32 byte acak, mis. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Jangan diganti setelah akun dibuat: password semua akun diturunkan dari nilai ini.
PIN_AUTH_SECRET=

# Dipakai mulai Fase 4 (Billing).
# MAIL_RELAY_URL=https://script.google.com/macros/s/<deployment-id>/exec
# MAIL_RELAY_SECRET=
