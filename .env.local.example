# Salin ke .env.local. Nilai ada di Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Dipakai mulai Fase 4 (Billing) — hanya di server, jangan diberi prefix NEXT_PUBLIC_.
# MAIL_RELAY_URL=https://script.google.com/macros/s/<deployment-id>/exec
# MAIL_RELAY_SECRET=
